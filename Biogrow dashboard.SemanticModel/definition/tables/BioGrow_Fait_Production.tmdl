	column Rendement_UFC_ml
		dataType: double
		formatString: #,0.00
		lineageTag: a6fe0fb7-905f-466c-9610-1f038aa53625
		summarizeBy: none
		sourceColumn: Rendement_UFC_ml

		annotation SummarizationSetBy = User

	column Categorie_Qualite =
			
			VAR Seuil = RELATED('BioGrow_Dim_Souches'[Seuil_Qualite])
			VAR Rendement = 'BioGrow_Fait_Production'[Rendement_UFC_ml]
			VAR pH = 'BioGrow_Fait_Production'[pH_Moyenne]
			VAR Temp = 'BioGrow_Fait_Production'[Temp_Moyenne]
			VAR TempOptimale = RELATED('BioGrow_Dim_Souches'[Temp_Optimale])
			VAR ToleranceTemp = 2 -- écart maximal (°C) à l'optimum de la souche pour un lot Premium
			VAR TempIdeale = ABS(Temp - TempOptimale) <= ToleranceTemp
			VAR pHIdeal = pH >= 6.5 && pH <= 7.5
			
			RETURN
			SWITCH(
			    TRUE(),
			    -- 0. DONNÉE MANQUANTE : souche sans seuil ni température optimale, ou lot sans rendement
			    ISBLANK(Seuil) || ISBLANK(Rendement) || ISBLANK(TempOptimale), "À vérifier",
			
			    -- 1. INVENDABLE : Le rendement ne respecte pas le minimum biologique
			    Rendement < Seuil, "Invendable",
			
			    -- 2. PREMIUM : Rendement OK + pH idéal + température proche de l'optimum de la souche
			    pHIdeal && TempIdeale, "Premium",
			
			    -- 3. VENDABLE : Rendement OK mais conditions de culture stressantes (pH ou température hors zone idéale)
			    "Vendable"
			)
		lineageTag: ecd6b062-fcd7-4f39-bc24-666dac4e063e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

