				    #"tmp et ph arrondir à 1 chif après la virgule" = Table.TransformColumns(#"Rendemant, temp, ph remplacer en decimal",{{"Temp_Moyenne", each Number.Round(_, 1), type number}, {"pH_Moyenne", each Number.Round(_, 1), type number}}),
